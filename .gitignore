# Python & virtualenv
__pycache__/
**/__pycache__/**
*.py[cod]
*$py.class
*.env
.env
.venv/
env/
venv/
ENV/

# Large datasets & raw data (>100MB exceeds GitHub limits)
/data/
/dataset/raw/combined2_dataset.csv.zip
/dataset/raw/*.csv

# Explicitly ensure src/data package is never ignored
!src/data/**
src/data/**/__pycache__/
src/data/**/*.py[cod]

# Geocode cache & persistent local logs
logs/
/data/geo_cache/

# Streamlit secrets & local configurations
.streamlit/secrets.toml

# Jupyter & testing
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
